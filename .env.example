# ══════════════════════════════════════════════════════════════════════════════
# SellerOS Demos — Complete Environment Configuration
# Copy this file to .env and fill in values for your session.
# All variables with =... require real values. All others have working defaults.
# ══════════════════════════════════════════════════════════════════════════════

# ── LLM Provider (shared/llm_router.py) ───────────────────────────────────────
# Controls which LLM backend all demo calls use.
# Options: openrouter | anthropic | openai | groq
# Default: openrouter (free tier — no credits needed for dev/demo sessions)
DEMO_LLM_PROVIDER=openrouter

# ── API Keys — set only the key for the active provider ───────────────────────
OPENROUTER_API_KEY=sk-or-v1-...        # free tier, ~200 req/day
ANTHROPIC_API_KEY=sk-ant-api03-...     # required for DEMO_LLM_PROVIDER=anthropic
                                       # also required by LQS Rufus scorer regardless of provider
OPENAI_API_KEY=sk-...                  # for DEMO_LLM_PROVIDER=openai
GROQ_API_KEY=gsk_...                   # for DEMO_LLM_PROVIDER=groq

# ── Zyte Ingestion Service (shared/zyte_client.py + LQS) ──────────────────────
ZYTE_BASE_URL=http://54.197.215.125:4001   # internal EC2 Zyte service (own product data)
ZYTE_API_KEY=...                            # required by CompetitorAnalysis module

# ── S3 Caching ────────────────────────────────────────────────────────────────
S3_BUCKET=opsell

# selleros_demos demo module prefixes (shared/s3_cache.py)
S3_RAW_PREFIX_KG=KeywordGap          # keyword_gap analysis results
S3_RAW_PREFIX_TE=TextEnhancement     # abd_optimizer results

# LQS module prefix (LQS/shared/s3_cache.py)
S3_RAW_PREFIX_LQS=LQS

# CompetitorAnalysis module prefix (CompetitorAnalysis/config/settings.py)
S3_RAW_PREFIX_CA=competitor-analysis

# Enrichment API combined result cache (enrichment_api/orchestrator.py)
S3_RAW_PREFIX_ENRICH=Enrichment

# ── Enrichment API inter-service URLs ─────────────────────────────────────────
LQS_API_URL=http://localhost:8001   # LQS FastAPI service base URL

# ── AWS Credentials ───────────────────────────────────────────────────────────
# Use explicit keys below OR set AWS_PROFILE to use a named credentials profile.
# On EC2 with an IAM role attached, all three can be omitted entirely.
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=ap-south-1

# ── LQS Module (LQS/config.py) ────────────────────────────────────────────────
OPSELL_COUNTRY_CODE=IN                       # Amazon marketplace country code
MODEL_PATH=DataStore/models/lqs_model.pkl    # path to trained LQS XGBoost model
ALLOW_ORIGINS=*                              # CORS allowed origins for LQS FastAPI

# ── Deprecated ────────────────────────────────────────────────────────────────
# OMKAR_API_KEY=ok_...    # Omkar Cloud API — replaced by Zyte + CompetitorAnalysis
