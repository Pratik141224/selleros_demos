# ── Provider selection ────────────────────────────────────────────────────────
# Controls which LLM backend all demo calls use.
# Options: openrouter | anthropic | openai | groq
# Default is openrouter (free tier — no credits needed for dev/demo sessions).
DEMO_LLM_PROVIDER=openrouter

# ── API Keys — only the key for the active provider is required ───────────────

# OpenRouter (default — free tier, 200 req/day)
OPENROUTER_API_KEY=sk-or-v1-...

# Anthropic — set DEMO_LLM_PROVIDER=anthropic for client-facing paid sessions
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI — set DEMO_LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...

# Groq — set DEMO_LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...

# ── Omkar Cloud API (D2 competitor data — always required) ────────────────────
OMKAR_API_KEY=ok_...
